################################################################################
### HYPRLAND CONFIG — woofi
### Rewritten 2026-07-26. Previous autogenerated config backed up to
### ~/.config/hypr-backup-20260726/hyprland.conf
### Palette: Catppuccin Mocha (matches Catppuccin-GnomeTheme)
################################################################################

################
### MONITORS ###
################
# Matched to your GNOME setup (~/.config/monitors.xml): eDP-1 @ scale 2, 90Hz.
monitor = eDP-1, 2880x1800@90, 0x0, 2

# Your ultrawide profile from GNOME (scale 1). Plug it in and check the
# connector name with `hyprctl monitors`, then rename this if it isn't DP-1.
# monitor = DP-1, 3440x1440@144, auto, 1

# Catch-all for any other display.
monitor = , preferred, auto, 1


###################
### MY PROGRAMS ###
###################
$terminal    = kitty
$fileManager = nautilus
$menu        = rofi -show drun
$lock        = hyprlock


#################
### AUTOSTART ###
#################
# Make the session bus aware of Wayland — required for xdg-desktop-portal
# and screen sharing to work correctly.
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Shell components
exec-once = waybar
exec-once = hyprpaper
exec-once = dunst

# Polkit agent — without this, GUI password prompts fail silently.
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Clipboard history (replaces the GNOME clipboard-indicator extension)
exec-once = wl-paste --type text  --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store

# ULauncher — same command as your GNOME autostart entry, including the
# GDK_BACKEND=x11 forcing and your ulauncher-guarded wrapper. It runs on
# XWayland; the Ctrl+Alt+S bind below drives it via ulauncher-toggle,
# because ULauncher's own internal hotkey cannot grab keys on Wayland.
exec-once = env GDK_BACKEND=x11 /home/woofi/.local/bin/ulauncher-guarded --hide-window


#############################
### ENVIRONMENT VARIABLES ###
#############################
env = XCURSOR_THEME,Vimix-white-cursors
env = XCURSOR_SIZE,24
env = HYPRCURSOR_THEME,Vimix-white-cursors
env = HYPRCURSOR_SIZE,24

# Qt apps: prefer Wayland, fall back to XWayland.
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = QT_AUTO_SCREEN_SCALE_FACTOR,1

# Run Electron apps (VS Code, Discord) natively on Wayland instead of
# XWayland. On this 2880x1800 @ scale-2 panel that is the difference between
# crisp and blurry — XWayland apps render at 1x and get upscaled.
env = ELECTRON_OZONE_PLATFORM_HINT,auto

# Firefox-family browsers on Wayland (harmless if not installed).
env = MOZ_ENABLE_WAYLAND,1


#####################
### LOOK AND FEEL ###
#####################
general {
    gaps_in = 5
    gaps_out = 12

    border_size = 2

    # Catppuccin Mocha: mauve -> blue gradient, surface0 when inactive
    col.active_border = rgba(cba6f7ee) rgba(89b4faee) 45deg
    col.inactive_border = rgba(313244aa)

    resize_on_border = true
    allow_tearing = false

    layout = dwindle
}

decoration {
    rounding = 10
    rounding_power = 2

    active_opacity = 1.0
    inactive_opacity = 1.0

    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = rgba(11111bee)
    }

    blur {
        enabled = true
        size = 6
        passes = 2
        new_optimizations = true
        vibrancy = 0.1696
    }
}

animations {
    enabled = yes, please :)

    bezier = easeOutQuint,   0.23, 1,    0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear,         0,    0,    1,    1
    bezier = almostLinear,   0.5,  0.5,  0.75, 1
    bezier = quick,          0.15, 0,    0.1,  1

    animation = global,        1, 10,   default
    animation = border,        1, 5.39, easeOutQuint
    animation = windows,       1, 4.79, easeOutQuint
    animation = windowsIn,     1, 4.1,  easeOutQuint, popin 87%
    animation = windowsOut,    1, 1.49, linear,       popin 87%
    animation = fadeIn,        1, 1.73, almostLinear
    animation = fadeOut,       1, 1.46, almostLinear
    animation = fade,          1, 3.03, quick
    animation = layers,        1, 3.81, easeOutQuint
    animation = layersIn,      1, 4,    easeOutQuint, fade
    animation = layersOut,     1, 1.5,  linear,       fade
    animation = fadeLayersIn,  1, 1.79, almostLinear
    animation = fadeLayersOut, 1, 1.39, almostLinear
    animation = workspaces,    1, 1.94, almostLinear, fade
    animation = workspacesIn,  1, 1.21, almostLinear, fade
    animation = workspacesOut, 1, 1.94, almostLinear, fade
    animation = zoomFactor,    1, 7,    quick
}

dwindle {
    pseudotile = true
    preserve_split = true
}

master {
    new_status = master
}

misc {
    # hyprpaper handles the wallpaper now, so disable the built-in ones.
    force_default_wallpaper = 0
    disable_hyprland_logo = true
    vfr = true            # cut GPU wakeups when the screen is static — laptop battery
    focus_on_activate = true
}


#############
### INPUT ###
#############
input {
    # Matched to GNOME (org.gnome.desktop.input-sources): German layout.
    # The autogenerated config said "us", which would have swapped y/z.
    kb_layout = de
    kb_variant =
    kb_model =
    kb_options = terminate:ctrl_alt_bksp
    kb_rules =

    follow_mouse = 1
    sensitivity = 0

    touchpad {
        natural_scroll = true
        disable_while_typing = true
        tap-to-click = true
        drag_lock = true
        scroll_factor = 0.4
    }
}

# 3-finger horizontal swipe switches workspaces (like GNOME).
gesture = 3, horizontal, workspace


##################
### WORKSPACES ###
##################
# You use GNOME's STATIC workspace model (dynamic-workspaces=false,
# num-workspaces=4). Marking 1-4 persistent reproduces that exactly: they
# always exist, so Ctrl+Alt+Left/Right always has all four to move between.
workspace = 1, persistent:true
workspace = 2, persistent:true
workspace = 3, persistent:true
workspace = 4, persistent:true


###################
### KEYBINDINGS ###
###################
# Mirrored from your GNOME bindings (org.gnome.desktop.wm.keybindings,
# org.gnome.shell.keybindings, media-keys) so muscle memory carries over.
$mainMod = SUPER

# --- Workspace switching: STRG+ALT+Left/Right (your GNOME binding) ---
bind = CTRL ALT, left,  workspace, e-1
bind = CTRL ALT, right, workspace, e+1
bind = CTRL ALT, up,    workspace, e-1
bind = CTRL ALT, down,  workspace, e+1

# GNOME's alternates for the same action
bind = $mainMod, Page_Up,   workspace, e-1
bind = $mainMod, Page_Down, workspace, e+1
bind = $mainMod ALT, left,  workspace, e-1
bind = $mainMod ALT, right, workspace, e+1
bind = $mainMod, Home,      workspace, 1
bind = $mainMod, End,       workspace, 4

# --- Move window to workspace: STRG+SHIFT+ALT+Left/Right ---
bind = CTRL SHIFT ALT, left,  movetoworkspace, e-1
bind = CTRL SHIFT ALT, right, movetoworkspace, e+1
bind = CTRL SHIFT ALT, up,    movetoworkspace, e-1
bind = CTRL SHIFT ALT, down,  movetoworkspace, e+1

bind = $mainMod SHIFT, Page_Up,   movetoworkspace, e-1
bind = $mainMod SHIFT, Page_Down, movetoworkspace, e+1
bind = $mainMod SHIFT ALT, left,  movetoworkspace, e-1
bind = $mainMod SHIFT ALT, right, movetoworkspace, e+1
bind = $mainMod SHIFT, Home,      movetoworkspace, 1
bind = $mainMod SHIFT, End,       movetoworkspace, 4

# --- Window cycling: Alt+Tab / Super+Tab (GNOME switch-applications) ---
bind = ALT, Tab, cyclenext
bind = ALT, Tab, bringactivetotop
bind = ALT SHIFT, Tab, cyclenext, prev
bind = ALT SHIFT, Tab, bringactivetotop
bind = $mainMod, Tab, cyclenext
bind = $mainMod, Tab, bringactivetotop
bind = $mainMod SHIFT, Tab, cyclenext, prev
bind = $mainMod SHIFT, Tab, bringactivetotop

# --- Window management (GNOME equivalents) ---
bind = ALT, F4,  killactive,          # GNOME: close
bind = $mainMod, Up,   fullscreen, 1  # GNOME: maximize
bind = $mainMod, Down, fullscreen, 0  # GNOME: unmaximize
bind = ALT, F10, fullscreen, 1        # GNOME: toggle-maximized
bind = ALT, F5,  fullscreen, 0        # GNOME: unmaximize
bind = ALT, F7,  exec, hyprctl dispatch movewindow          # GNOME: begin-move
bind = ALT, F8,  exec, hyprctl dispatch resizeactive exact 50%% 50%%  # begin-resize

# GNOME "minimize" (Super+H). Hyprland has no minimise, so this stashes the
# window on a hidden special workspace; Super+Shift+H shows the stash.
bind = $mainMod, H,       movetoworkspacesilent, special:minimized
bind = $mainMod SHIFT, H, togglespecialworkspace, minimized

# --- Move window between monitors: Super+Shift+arrows (GNOME) ---
bind = $mainMod SHIFT, left,  movewindow, mon:l
bind = $mainMod SHIFT, right, movewindow, mon:r
bind = $mainMod SHIFT, up,    movewindow, mon:u
bind = $mainMod SHIFT, down,  movewindow, mon:d

# --- Focus between windows (Hyprland tiling; no GNOME analogue) ---
bind = $mainMod, left,  movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up,    movefocus, u
bind = $mainMod, down,  movefocus, d

# --- Launchers ---
# ULauncher on STRG+ALT+S, exactly as your GNOME custom shortcut "Ulouncher".
bind = CTRL ALT, S, exec, ulauncher-toggle
bind = $mainMod, A, exec, $menu              # GNOME: toggle-application-view
bind = ALT, F2,     exec, rofi -show run     # GNOME: panel-run-dialog
bind = $mainMod, L, exec, $lock              # GNOME: screensaver
bind = CTRL ALT, Delete, exec, wlogout       # GNOME: logout
bind = $mainMod, N, exec, dunstctl history-pop  # GNOME: focus notification

# Terminal / file manager (GNOME has no default binding for these)
bind = $mainMod, Return, exec, $terminal
bind = $mainMod, Q,      exec, $terminal
bind = $mainMod, E,      exec, $fileManager
bind = $mainMod, B,      exec, brave

# --- Tiling-specific (no GNOME equivalent) ---
bind = $mainMod, V, togglefloating,
bind = $mainMod, F, fullscreen, 0
bind = $mainMod, P, pseudo,
# togglesplit is a dwindle LAYOUT MESSAGE, not a dispatcher — "dispatch
# togglesplit" returns "Invalid dispatcher" on 0.56. Verified via hyprctl.
bind = $mainMod, J, layoutmsg, togglesplit
bind = $mainMod, grave, togglespecialworkspace, magic
bind = $mainMod SHIFT, grave, movetoworkspace, special:magic

# Exit Hyprland. The default config had this on plain SUPER+M, which killed
# the session instantly with no confirmation.
bind = $mainMod SHIFT, M, exit,

bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up,   workspace, e-1

# --- Mouse drag ---
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# --- Screenshots (matches GNOME's Print/Shift+Print/Alt+Print) ---
bind = , Print,      exec, grim -g "$(slurp)" - | swappy -f -   # show-screenshot-ui
bind = SHIFT, Print, exec, grim - | swappy -f -                 # full screen
bind = ALT, Print,   exec, grim -g "$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')" - | swappy -f -

# --- Clipboard history (replaces clipboard-indicator) ---
bind = $mainMod SHIFT, V, exec, cliphist list | rofi -dmenu -p "Clipboard" | cliphist decode | wl-copy

# --- Media & brightness (hardware keys) ---
bindel = , XF86AudioRaiseVolume,  exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume,  exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = , XF86AudioMute,         exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = , XF86AudioMicMute,      exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = , XF86MonBrightnessUp,   exec, brightnessctl -e4 -n2 set 5%+
bindel = , XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

bindl = , XF86AudioNext,  exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay,  exec, playerctl play-pause
bindl = , XF86AudioPrev,  exec, playerctl previous


##############################
### WINDOWS AND WORKSPACES ###
##############################
# Fix XWayland dialogs stealing focus oddly.
windowrule = suppressevent maximize, class:.*

# Fix cursor glitches on some XWayland drag-and-drop.
windowrule = nofocus, class:^$, title:^$, xwayland:1, floating:1, fullscreen:0, pinned:0

# Float common dialogs
windowrule = float, class:^(org.gnome.Nautilus)$, title:^(Properties|Preferences)$
windowrule = float, class:^(pavucontrol|blueman-manager|nm-connection-editor)$
windowrule = float, title:^(Open File|Save File|Choose Files)$

# ULauncher: it draws as an X11 override-redirect window. Keep it floating,
# unfocused-safe, and out of the tiling layout.
windowrule = float, class:^(ulauncher)$
windowrule = noborder, class:^(ulauncher)$
windowrule = noshadow, class:^(ulauncher)$
windowrule = stayfocused, class:^(ulauncher)$

# Picture-in-picture always floats and stays on top
windowrule = float, title:^(Picture-in-Picture)$
windowrule = pin,   title:^(Picture-in-Picture)$
