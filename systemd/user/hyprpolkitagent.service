[Unit]
StartLimitIntervalSec=0
Description=Polkit authentication agent for Hyprland
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/hyprpolkitagent/hyprpolkitagent
Restart=on-failure
RestartSec=2

[Install]
# NOT graphical-session.target, which never activates under Hyprland.
WantedBy=default.target
