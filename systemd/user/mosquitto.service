[Unit]
Description=Mosquitto MQTT broker (desktop event bus)
Documentation=man:mosquitto.conf(5)
# Nothing else may create the socket path, and the shell needs the broker
# before it starts subscribing.
# NOT graphical-session.target. That target is never activated under Hyprland
# -- it belongs to systemd-managed sessions, and `systemctl --user is-active
# graphical-session.target` reports inactive here. Units wanted by it therefore
# never started at login at all; they only ran when started by hand, which is
# exactly why the desktop came up with no live data.
#
# default.target is the user manager's own target and is always active.

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/mosquitto -c %h/.config/mosquitto/mosquitto.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1

# The broker needs no filesystem access beyond its socket and no privileges at
# all. Every one of these is a capability it would otherwise inherit from the
# user session for no reason.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Hard stop above the broker's own 32 MB memory_limit, so a leak anywhere in the
# process -- not just in mosquitto's own accounting -- is still bounded.
MemoryMax=80M

[Install]
WantedBy=default.target
