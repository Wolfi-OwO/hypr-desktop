#!/usr/bin/env python3
"""Installed applications as JSON, for the shell's application menu.

WHY THIS EXISTS
---------------
The menu used to build this list inline, in shell, with a loop that ran four
`grep` calls plus `cut`, `sed` and `basename` per .desktop file. Measured on
this machine: 225 files, **1463 processes forked, 927 ms** -- and that ran every
single time the menu opened, which is exactly the delay that made the menu feel
like it took seconds to react.

This reads each file once, in one process. Measured at roughly 30 ms cold.

The result is also cached, so the menu never waits even that long: the shell
subscribes to the retained MQTT topic that hypr-eventd publishes from here, so
the list is on screen the moment the panel opens.

Output: one JSON array of {name, exec, icon, wmclass}, sorted case-insensitively.

Usage:
    hypr-applist            print the cache if it is fresh, else rebuild
    hypr-applist --force    rebuild regardless
"""

import json
import os
import re
import sys
import time

# XDG_DATA_DIRS is the correct source, but it is not always exported into a
# Wayland session started by a display manager; these three cover this machine
# either way. Later entries win on a name clash, matching XDG precedence.
DIRS = [
    "/usr/share/applications",
    os.path.expanduser("~/.local/share/applications"),
    "/var/lib/flatpak/exports/share/applications",
    os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
]

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "hypr"
)
os.makedirs(CACHE_DIR, exist_ok=True)
CACHE = os.path.join(CACHE_DIR, "hypr-applist.json")

# Field codes a launcher must strip: they are placeholders the desktop entry
# spec fills in with files or URLs, and passing them through literally makes the
# command fail.
FIELD_CODES = re.compile(r"%[fFuUdDnNickvm]")


def parse(path):
    """Read the [Desktop Entry] group of one file. Returns None if not shown."""
    name = exec_ = icon = wmclass = ""
    in_entry = False
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.rstrip("\n")
                if line.startswith("["):
                    # Only the first group matters. Actions such as
                    # [Desktop Action new-window] carry their own Name= and Exec=
                    # and would otherwise overwrite the real ones.
                    if in_entry:
                        break
                    in_entry = line == "[Desktop Entry]"
                    continue
                if not in_entry or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                key = key.strip()
                if key in ("NoDisplay", "Hidden") and value.strip().lower() == "true":
                    return None
                elif key == "Type" and value.strip() != "Application":
                    return None
                elif key == "Name" and not name:
                    name = value.strip()
                elif key == "Exec" and not exec_:
                    exec_ = FIELD_CODES.sub("", value).strip()
                elif key == "Icon" and not icon:
                    icon = value.strip()
                elif key == "StartupWMClass" and not wmclass:
                    wmclass = value.strip()
    except OSError:
        return None

    if not name or not exec_:
        return None
    if not wmclass:
        wmclass = os.path.basename(path)[: -len(".desktop")]
    return {"name": name, "exec": exec_, "icon": icon, "wmclass": wmclass}


def newest_mtime():
    """Newest directory mtime, used to decide whether the cache is still valid.

    A directory's mtime changes when a .desktop file is added or removed, which
    is what actually invalidates this list. An application updating in place
    without changing its entry does not need a rebuild.
    """
    newest = 0.0
    for d in DIRS:
        try:
            newest = max(newest, os.stat(d).st_mtime)
        except OSError:
            continue
    return newest


def build():
    by_id = {}
    for d in DIRS:
        try:
            entries = os.listdir(d)
        except OSError:
            continue
        for fn in entries:
            if not fn.endswith(".desktop"):
                continue
            app = parse(os.path.join(d, fn))
            if app:
                # Keyed by filename so a user override in ~/.local/share wins
                # over the system entry of the same id -- which is the whole
                # point of the override that makes GNOME Settings visible here.
                by_id[fn] = app
    apps = sorted(by_id.values(), key=lambda a: a["name"].lower())
    return {"apps": apps, "stamp": int(time.time()), "dirs_mtime": newest_mtime()}


def main():
    force = "--force" in sys.argv

    if not force:
        try:
            with open(CACHE, encoding="utf-8") as f:
                cached = json.load(f)
            if abs(cached.get("dirs_mtime", -1) - newest_mtime()) < 0.001:
                json.dump(cached, sys.stdout, ensure_ascii=False)
                sys.stdout.write("\n")
                return
        except (OSError, ValueError):
            pass

    data = build()
    tmp = CACHE + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, CACHE)  # atomic; never a half-written cache
    except OSError:
        pass
    json.dump(data, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
