#!/usr/bin/env bash
# Forces a real DPMS off/on toggle after resume, then rechecks for ~44s and
# re-forces it if the panel silently goes black again. A single "on" isn't
# enough -- Hyprland can report dpmsStatus true while the panel stays dark,
# so this doesn't trust one reading, only two in a row.
#
# Runs detached; the caller doesn't block on it.
#
# LOG (temporary, 2026-08-08): a "screen stays black for ~30s after opening
# the lid" report doesn't match any known cause yet, and this loop -- up to
# 22 retries, 2s apart -- is the only thing in the resume path whose own
# worst case is close to that duration. Nothing here was ever logged, so
# there was no way to tell whether this loop is the actual cause or an
# innocent bystander converging quickly while something else is slow.
# Logging is/force_redraw calls with timestamps below so the NEXT real
# lid-open leaves evidence instead of another guess. Truncates each run --
# only the most recent resume matters. Remove once #123 is root-caused.
LOG=/home/woofi/.local/state/hypr-dpms-ensure-on.log
mkdir -p "$(dirname "$LOG")"
: > "$LOG"
log() { printf '%(%H:%M:%S)T %s\n' -1 "$1" >> "$LOG"; }

set -uo pipefail

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
HIS=$(/bin/ls "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -1)
export HYPRLAND_INSTANCE_SIGNATURE="$HIS"
log "start his=$HIS"

is_on() {
    hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    m = json.load(sys.stdin)
    sys.exit(0 if all(o.get("dpmsStatus") for o in m) else 1)
except Exception:
    sys.exit(1)
'
}

# Current eDP-1 mode/position/scale, read live so the re-enable below
# reapplies exactly what's already configured -- no hardcoded resolution
# or scale to drift from the real thing. Printed as "mode position scale"
# (three fields, space-separated) for `read` in force_redraw.
#
# This machine runs the Hyprland Lua config plugin: `hyprctl keyword
# monitor ...` -- the normal way to reconfigure a monitor at runtime --
# is rejected outright ("keyword can't work with non-legacy parsers. Use
# eval."), so force_redraw goes through `hyprctl eval` calling the Lua
# plugin's own hl.monitor() instead. Confirmed live: hl.monitor() with
# disabled=true DOES disable the output (`hyprctl monitors all` showed it
# missing and a FALLBACK monitor in its place); re-enabling needs
# disabled=false EXPLICITLY passed alongside mode/position/scale -- a call
# that only repeats the mode without it left the output disabled, grim
# unable to find "eDP-1" at all, requiring a manual eval to recover.
modeline() {
    hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    for o in json.load(sys.stdin):
        if o.get("name") == "eDP-1":
            w, h, r, x, y, s = o["width"], o["height"], o["refreshRate"], o["x"], o["y"], o["scale"]
            print(f"{w}x{h}@{r:.2f} {x}x{y} {s}")
            break
except Exception:
    pass
'
}

force_redraw() {
    log "force_redraw: dpms off"
    hyprctl dispatch 'hl.dsp.dpms("off")' >/dev/null 2>&1
    sleep 0.2
    log "force_redraw: dpms on"
    hyprctl dispatch 'hl.dsp.dpms("on")' >/dev/null 2>&1

    # Measured 2026-08-10: this loop converged on dpmsStatus=true after one
    # off/on toggle, twice in a row, and exited -- but the panel stayed
    # black for another ~2 minutes until the machine was power-cycled.
    # dpmsStatus is Hyprland's own belief, not a hardware truth signal; a
    # DPMS blank/unblank is not always enough to un-wedge a panel the EC
    # firmware bug (see TROUBLESHOOTING.md) left stuck. A real modeset --
    # tearing the connector down and reinitialising it, not just toggling
    # its power state -- is the known stronger recovery for that class of
    # stuck panel, so it runs every time DPMS is forced, not only when
    # dpmsStatus itself reads false.
    read -r mode pos scale <<< "$(modeline)"
    if [ -n "$mode" ]; then
        log "force_redraw: modeset disable"
        hyprctl eval 'hl.monitor({output = "eDP-1", disabled = true})' >/dev/null 2>&1
        sleep 0.3
        log "force_redraw: modeset $mode $pos $scale"
        hyprctl eval "hl.monitor({output = \"eDP-1\", disabled = false, mode = \"$mode\", position = \"$pos\", scale = $scale})" >/dev/null 2>&1
    fi
}

force_redraw

consecutive_on=0
for i in $(seq 1 22); do
    sleep 2
    if is_on; then
        consecutive_on=$((consecutive_on + 1))
        log "check $i: on (streak $consecutive_on)"
        if [ "$consecutive_on" -ge 2 ]; then
            log "done: converged after ${i}x2s"
            exit 0
        fi
    else
        consecutive_on=0
        log "check $i: OFF -- re-forcing"
        force_redraw
    fi
done
log "done: exhausted 22 retries without converging"
