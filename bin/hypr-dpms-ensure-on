#!/usr/bin/env bash
# Forces a real DPMS off/on toggle after resume, then rechecks for ~44s and
# re-forces it if the panel silently goes black again. A single "on" isn't
# enough -- Hyprland can report dpmsStatus true while the panel stays dark,
# so this doesn't trust one reading, only two in a row.
#
# Runs detached; the caller doesn't block on it.
#
# LOG: started during the investigation into a "screen stays black after
# opening the lid" report. The root cause (hyprlock's lockdead screen when
# modeset_cycle disables eDP-1 while a lock surface owns it -- see
# modeset_cycle below) was found on 2026-08-26 by reproducing it
# deliberately and capturing grim screenshots, not from this log. It stays
# anyway: it's the only record of how many dpms_toggle/modeset cycles a
# given resume actually needed to converge, which is worth having if the
# convergence timing itself ever regresses. Truncates each run -- only the
# most recent resume matters.
LOG=/home/woofi/.local/state/hypr-dpms-ensure-on.log
log() { printf '%(%H:%M:%S)T %s\n' -1 "$1" >> "$LOG"; }

set -uo pipefail

# Exactly one instance at a time. Two independent callers can both fire it on
# the same resume -- hypr-post-resume (after_sleep_cmd) and hypr-lock both
# launch this, and on a fast lid-close-then-open both hypridle actions can
# land in the same second. Two copies then raced the same DPMS toggle and
# modeset cycle against each other, and both truncated the SAME log file,
# interleaving their output into a garbled, undebuggable mess. Same flock
# idiom hypr-lock already uses for the identical problem: a second caller
# finds the lock held and exits quietly rather than starting a competing
# recovery run -- the screen ends up recovered either way, which is all any
# caller wanted.
#
# Measured 2026-08-12: the truncate used to happen ABOVE this lock, so even
# with the lock stopping both copies from doing recovery work, the SECOND
# copy still truncated the log out from under the first, mid-write -- the
# log for a real resume was missing its own opening lines, cut off right
# where the second caller's truncate landed. Truncating only happens now
# once a copy has actually won the lock, so only the copy that keeps running
# ever touches the file.
LOCKFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr-dpms-ensure-on.flock"
if exec 8>"$LOCKFILE" 2>/dev/null; then
    flock -n 8 || exit 0   # someone else is already recovering -- exit quietly
fi   # lock file couldn't be made: fall through and still run, unguarded

mkdir -p "$(dirname "$LOG")"
: > "$LOG"

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
HIS=$(/bin/ls "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -1)
export HYPRLAND_INSTANCE_SIGNATURE="$HIS"
log "start his=$HIS"

is_on() {
    hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    m = json.load(sys.stdin)
    sys.exit(0 if all(o.get("dpmsStatus") for o in m) else 1)
except Exception:
    sys.exit(1)
'
}

# Current eDP-1 mode/position/scale, read live so the re-enable below
# reapplies exactly what's already configured -- no hardcoded resolution
# or scale to drift from the real thing. Printed as "mode position scale"
# (three fields, space-separated) for `read` in force_redraw.
#
# This machine runs the Hyprland Lua config plugin: `hyprctl keyword
# monitor ...` -- the normal way to reconfigure a monitor at runtime --
# is rejected outright ("keyword can't work with non-legacy parsers. Use
# eval."), so force_redraw goes through `hyprctl eval` calling the Lua
# plugin's own hl.monitor() instead. Confirmed live: hl.monitor() with
# disabled=true DOES disable the output (`hyprctl monitors all` showed it
# missing and a FALLBACK monitor in its place); re-enabling needs
# disabled=false EXPLICITLY passed alongside mode/position/scale -- a call
# that only repeats the mode without it left the output disabled, grim
# unable to find "eDP-1" at all, requiring a manual eval to recover.
modeline() {
    hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
try:
    for o in json.load(sys.stdin):
        if o.get("name") == "eDP-1":
            w, h, r, x, y, s = o["width"], o["height"], o["refreshRate"], o["x"], o["y"], o["scale"]
            print(f"{w}x{h}@{r:.2f} {x}x{y} {s}")
            break
except Exception:
    pass
'
}

dpms_toggle() {
    log "dpms_toggle: off"
    hyprctl dispatch 'hl.dsp.dpms("off")' >/dev/null 2>&1
    sleep 0.2
    log "dpms_toggle: on"
    hyprctl dispatch 'hl.dsp.dpms("on")' >/dev/null 2>&1
}

# Measured 2026-08-10: dpms_toggle alone converged on dpmsStatus=true, twice
# in a row, and exited -- but the panel stayed black for another ~2 minutes
# until the machine was power-cycled. dpmsStatus is Hyprland's own belief,
# not a hardware truth signal; a DPMS blank/unblank is not always enough to
# un-wedge a panel the EC firmware bug (see TROUBLESHOOTING.md) left stuck.
# A real modeset -- tearing the connector down and reinitialising it -- is
# the known stronger recovery for that class of stuck panel.
#
# Measured again 2026-08-11: running this on EVERY resume, not just stuck
# ones, is its own bug. Disabling the output makes Hyprland briefly drop
# eDP-1 entirely -- hyprlock's lock surface, which is bound to that output,
# falls back to a synthetic "FALLBACK" placeholder screen for the ~1s the
# real output is gone, then creates a fresh lock surface once eDP-1
# reappears. That fallback-then-fresh-surface cycle is exactly the "error
# lockscreen flashes briefly" report -- a real, guaranteed, every-resume
# regression traded for a rare one. Only escalates here now, on a retry
# that already found dpms_toggle insufficient, not on the first attempt.
#
# Measured again 2026-08-12: escalating on a SINGLE failed check was still
# firing the same FALLBACK flash on plenty of ordinary resumes -- confirmed
# via journalctl: a resume with no flash (12:55:49) never logged a FALLBACK
# line and never needed a second dpms_toggle; an earlier one that did flash
# (18:04:05) did. The panel legitimately not answering the DPMS check within
# the first 2s (still catching up from resume) looks identical, at check 1,
# to a genuinely stuck panel -- there was no way to tell them apart that
# early. Below now waits for 3 consecutive misses (~6s of real, sustained
# failure) before reaching for modeset, so an ordinary slow-to-wake panel
# recovers via plain dpms_toggle -- no flash -- and only a panel that's
# actually stuck escalates, just ~6s later than before.
#
# Measured 2026-08-26, reproduced deliberately and confirmed with grim: the
# "FALLBACK flash" above was an understatement. Disabling eDP-1 while
# hyprlock's lock surface is bound to it doesn't just flash a placeholder --
# Hyprland treats the lock surface as gone and drops into its lockdead
# screen ("it looks like you locked your screen but the lockscreen ...
# crashed", the handwritten-logo recovery screen), captured in
# during_disabled.png/after_reenable.png. Re-enabling the output afterwards
# does NOT clear it; the session sat on that screen until hyprlock's own
# process exited. Escalating on 3 misses only lowered how OFTEN this fires,
# it never stopped it from being able to fire -- and it's still owning a
# resource (the monitor) that a locked session's lock surface owns first.
# One owner per job: skip the modeset entirely whenever hyprlock is running,
# same as the flock already does for two hyprlock instances. dpms_toggle
# alone is still tried every 2s regardless (it's the thing that DOESN'T
# touch the output's existence, and 2026-08-10 already measured it can
# converge on its own).
modeset_cycle() {
    if pgrep -x hyprlock >/dev/null 2>&1; then
        log "modeset_cycle: skipped -- hyprlock owns eDP-1 right now, disabling it would kill the lock surface (2026-08-26 lockdead repro)"
        return 0
    fi
    read -r mode pos scale <<< "$(modeline)"
    if [ -n "$mode" ]; then
        log "modeset_cycle: disable"
        hyprctl eval 'hl.monitor({output = "eDP-1", disabled = true})' >/dev/null 2>&1
        sleep 0.3
        log "modeset_cycle: $mode $pos $scale"
        hyprctl eval "hl.monitor({output = \"eDP-1\", disabled = false, mode = \"$mode\", position = \"$pos\", scale = $scale})" >/dev/null 2>&1
    fi
}

dpms_toggle

consecutive_on=0
consecutive_off=0
for i in $(seq 1 22); do
    sleep 2
    if is_on; then
        consecutive_on=$((consecutive_on + 1))
        consecutive_off=0
        log "check $i: on (streak $consecutive_on)"
        if [ "$consecutive_on" -ge 2 ]; then
            log "done: converged after ${i}x2s"
            exit 0
        fi
    else
        consecutive_on=0
        consecutive_off=$((consecutive_off + 1))
        log "check $i: OFF (streak $consecutive_off)"
        if [ "$consecutive_off" -ge 3 ]; then
            log "check $i: 3 misses in a row -- escalating to modeset"
            modeset_cycle
            consecutive_off=0
        fi
        dpms_toggle
    fi
done
log "done: exhausted 22 retries without converging"
