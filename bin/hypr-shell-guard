#!/usr/bin/env bash
# Watches that the shell's layer surfaces are actually on screen.
#
# Background: Quickshell once kept running as a process while having not a
# single layer surface left -- `hyprctl layers` was empty. No bar, no wallpaper
# and no widgets, even though `pgrep qs` reported a healthy process. A plain
# process watchdog (systemd Restart=always) would not have noticed, because
# nothing had crashed.
#
# The cause was never reproduced; the most likely candidate is the output
# briefly disappearing, at which point `Variants` over `Quickshell.screens`
# tears its children down and does not build them back up. This watchdog
# therefore checks the VISIBLE result rather than the process.
#
# Started from the autostart section in hyprland.lua.

set -uo pipefail

INTERVAL=8
CONFIG="$HOME/.config/quickshell"

# Namespaces that must be present. If one of them is missing the shell is not
# functional, whatever the process status says.
EXPECTED=(quickshell-bar quickshell-widgets quickshell-wallpaper)

# Returns 0 when every expected namespace is present.
surfaces_present() {
    local layers ns
    layers=$(hyprctl layers 2>/dev/null)
    [ -n "$layers" ] || return 0              # hyprctl did not answer; assume fine
    for ns in "${EXPECTED[@]}"; do
        printf '%s' "$layers" | grep -q "namespace: $ns" || return 1
    done
    return 0
}

restart_shell() {
    # -x -f, NOT a bare -f. `pkill -f qs` matches any command line containing
    # "qs", which includes the shell running this very script -- it killed the
    # wrong process twice before the flags were tightened.
    pkill -x -f "qs -c $CONFIG" 2>/dev/null
    sleep 2
    setsid qs -c "$CONFIG" >/dev/null 2>&1 < /dev/null &
    # Then wait longer than the check interval: building the surfaces takes a
    # few seconds, and without this the next check would fire immediately and
    # restart a shell that was still starting up.
    sleep 12
}

while true; do
    sleep "$INTERVAL"

    # With no compositor running there is nothing to check.
    hyprctl version >/dev/null 2>&1 || continue

    surfaces_present && continue

    # Confirm the fault a second time before acting on it.
    #
    # Restarting the shell deliberately -- by hand, or after a config change --
    # briefly leaves zero layer surfaces, which looks exactly like the failure
    # this watchdog exists to catch. Acting on the first observation started a
    # SECOND Quickshell on top of the one just launched, and two instances each
    # drawing a full set of surfaces cost several hundred megabytes. That
    # happened. One interval of patience removes the whole race.
    sleep "$INTERVAL"
    surfaces_present && continue

    logger -t hypr-shell-guard "shell surfaces missing, restarting Quickshell"
    restart_shell
done
