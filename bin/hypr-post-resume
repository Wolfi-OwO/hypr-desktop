#!/usr/bin/env bash
# Runs after resume (hypridle's after_sleep_cmd). Forces a real DPMS
# off-then-on toggle so the panel redraws -- a plain "on" is a no-op if
# Hyprland already thinks it's on while the screen stays dark.
#
# Used to also restart hypridle.service here to clear a stale idle timer,
# but that caused two real crashes by racing hypridle's own lock attempt
# ("Seems we got yeeten" in its log). Removed once the actual cause (the
# 480s listener dispatching dpms off) was fixed directly in hypridle.conf.

systemd-run --user --scope --collect --quiet -- \
    /home/woofi/.local/bin/hypr-dpms-ensure-on >/dev/null 2>&1 &
disown

# Screen and keyboard backlight both go to full on resume, unconditionally --
# not a restore of whatever level they were at before suspend. hypridle's own
# idle-dim listener has an on-resume too (hypridle.conf), but that one
# restores the SAVED pre-dim level, and can fire around the same moment this
# does: the activity that wakes the machine from suspend is the same activity
# that ends an idle period. The sleep is deliberate -- it lets that restore
# run first, so setting full brightness here is the last write and always
# wins, rather than the two racing for whichever happens to land last.
{
    sleep 0.5
    brightnessctl set 100% >/dev/null 2>&1
    brightnessctl -d platform::kbd_backlight set 100% >/dev/null 2>&1
} &
disown
