#!/usr/bin/env bash
# Runs after resume (hypridle's after_sleep_cmd). Forces a real DPMS
# off-then-on toggle so the panel redraws -- a plain "on" is a no-op if
# Hyprland already thinks it's on while the screen stays dark.
#
# Used to also restart hypridle.service here to clear a stale idle timer,
# but that caused two real crashes by racing hypridle's own lock attempt
# ("Seems we got yeeten" in its log). Removed once the actual cause (the
# 480s listener dispatching dpms off) was fixed directly in hypridle.conf.

systemd-run --user --scope --collect --quiet -- \
    /home/woofi/.local/bin/hypr-dpms-ensure-on >/dev/null 2>&1 &
disown

# Screen and keyboard backlight both go to full on resume, unconditionally --
# not a restore of whatever level they were at before suspend. hypridle's own
# idle-dim listeners have on-resume handlers too (hypridle.conf) that restore
# the SAVED pre-dim level, and they fire in the very same instant this
# script starts, not some time later -- measured at a real lid-open:
# `brightnessctl -r` landed the SAME SECOND as this script, restoring to 3%.
# The sleep below outlasts that.
#
# First version of this fix ran its brightnessctl calls in a bare
# `{ ... } & disown` block instead of handing them to systemd-run like the
# dpms-ensure-on call above. Measured at the next real resume: no trace of
# it in the journal at all, and brightness stayed at 3% -- disown keeps
# bash's own job control from signalling it, but says nothing about
# whatever reaps this script's process group once hypridle considers the
# after_sleep_cmd handled. systemd-run --scope is what actually survives
# that, proven by the dpms-ensure-on call two lines up succeeding on the
# same resume where the bare block silently didn't.
systemd-run --user --scope --collect --quiet -- \
    sh -c 'sleep 0.6
           brightnessctl set 100%
           brightnessctl -d platform::kbd_backlight set 100%' \
    >/dev/null 2>&1 &
disown
